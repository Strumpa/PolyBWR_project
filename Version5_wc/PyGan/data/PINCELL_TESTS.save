#!/bin/sh
#
if [ $# = 0 ]
   then
   echo '$$$ ----- PINCELL_TESTS.save : script begin' 1>&2
   exit 1
fi
echo '$$$ ----- PINCELL_TESTS.save : script begin'
MACH=`uname -s`
Sysx="`echo $MACH | cut -b -6`"
if [ $Sysx = "CYGWIN" ]; then
   MACH=`uname -o`
elif [ $Sysx = "AIX" ]; then
   MACH=`uname -s`
else
   MACH=`uname -sm | sed 's/[ ]/_/'`
fi

cp _COMPO* ./BWR_PINCELL_TESTS_results
cp *CPO* ./BWR_PINCELL_TESTS_results
cp -r BWR_PINCELL_TESTS_results $1/"$MACH"/
echo '$$$ ----- PINCELL_TESTS.save : script finish'
