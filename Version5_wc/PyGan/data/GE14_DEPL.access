#!/bin/sh
if [ $# = 0 ]
   then
   echo "usage: GE14_DEPL.access directory" 1>&2
   exit 1
fi
MACH=`uname -s`
Sysx="`echo $MACH | cut -b -6`"
if [ $Sysx = "CYGWIN" ]; then
MACH=`uname -o`
elif [ $Sysx = "Darwin" ]; then
MACH=`uname -sm`
elif [ $Sysx = "SunOS" ]; then
MACH=`uname -sm`
fi
if [ "$MACH" = "Linux" -o "$MACH" = "OSF1" -o "$MACH" = "Cygwin" -o "$MACH" = "SunOS i86pc" -o \
"$MACH" = "Darwin i386" -o "$MACH" = "Darwin x86_64" -o "$MACH" = "Darwin_arm64" ]
then 
echo 'use little endian libraries'
pos=$1/../../../libraries/l_endian
else
echo 'use big endian libraries'
pos=$1/../../../libraries/b_endian
fi

ln -s "$pos"/draglibshem295_endfb8r1_mt18_idecay1_v5p1_28052026 e81d1mt18
ln -s "$pos"/draglibshem295_endfb8r1_mt18_idecay1_v5p1_29052026 e81d1mt18v2
ln -s "$pos"/draglibendfb8r1SHEM295_v5p1 endfb8r1_295

ln -s "$1"/data/GE14_DEPL_proc/tdt_files/GE14_DOM_DIAG_SSH_3x3_IC_TISO_MACRO.dat . 
ln -s "$1"/data/GE14_DEPL_proc/tdt_files/GE14_VAN_DIAG_SSH_3x3_IC_TISO_MACRO.dat . 
ln -s "$1"/data/GE14_DEPL_proc/tdt_files/GE14_DOM_DIAG_FLUXL1_3x3_6x6_IC_TISO_MACRO.dat . 
ln -s "$1"/data/GE14_DEPL_proc/tdt_files/GE14_VAN_DIAG_FLUXL1_3x3_6x6_IC_TISO_MACRO.dat . 
ln -s "$1"/data/GE14_DEPL_proc/tdt_files/GE14_DOM_DIAG_FLUXL2_MOC_TSPC.dat . 
ln -s "$1"/data/GE14_DEPL_proc/tdt_files/GE14_VAN_DIAG_FLUXL2_MOC_TSPC.dat . 

echo "GE14_DEPL.access script terminated"
fi