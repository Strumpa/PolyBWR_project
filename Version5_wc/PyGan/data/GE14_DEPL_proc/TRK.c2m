* PROCEDURE TRK.c2m : tracking
* --------------------------------
* Procedure generated by starterDD
* --------------------------------
*    INPUT & OUTPUT PARAMETERS
* --------------------------------
PARAMETER TRKSSH TRKFILSSH TRKFLUXL1 TRKFILFLUXL1 TRKFLUXL2 TRKFILFLUXL2 ::
::: LINKED_LIST TRKSSH ;
::: SEQ_BINARY TRKFILSSH ;
::: LINKED_LIST TRKFLUXL1 ;
::: SEQ_BINARY TRKFILFLUXL1 ;
::: LINKED_LIST TRKFLUXL2 ;
::: SEQ_BINARY TRKFILFLUXL2 ;
;
STRING tdtsshName tdtL1Name tdtL2Name ;
:: >>tdtsshName<< >>tdtL1Name<< >>tdtL2Name<< ;

SEQ_ASCII tdtssh :: FILE <<tdtsshName>> ;
SEQ_ASCII tdtfluxl1 :: FILE <<tdtL1Name>> ;
SEQ_ASCII tdtfluxl2 :: FILE <<tdtL2Name>> ;

MODULE SALT: MCCGT: END: ;

* Tracking for step SSH
TRKSSH TRKFILSSH := SALT: tdtssh ::
    EDIT 2
    TITLE 'SSH - IC'
    ANIS 4
    TISO 8 25.0
    IC EPSJ 1.0E-5
;

* Tracking for step FLUXL1
TRKFLUXL1 TRKFILFLUXL1 := SALT: tdtfluxl1 ::
    EDIT 2
    TITLE 'FLUXL1 - IC'
    ANIS 4
    TISO 12 35.0
    IC EPSJ 1.0E-5
;

* Tracking for step FLUXL2
TRKFLUXL2 TRKFILFLUXL2 := SALT: tdtfluxl2 ::
    EDIT 2
    TITLE 'FLUXL2 - MOC'
    BATCH 1000
    ANIS 4
    ALLG
    TSPC 14 50.0 REND
    NOIC
;

* MOC tracking for step FLUXL2
TRKFLUXL2 := MCCGT: TRKFLUXL2 TRKFILFLUXL2 ::
    EDIT 1
    GAUS 4 AAC 80 TMT EPSI 1E-5
;

END: ;
QUIT .
