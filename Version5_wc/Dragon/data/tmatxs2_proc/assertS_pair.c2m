*
* Author: B.A.H. Meunier
* Assert procedure for non-regression testing.
* Compare a value from two real arrays.
*
PARAMETER LCMREF LCMCAL :: ::: LINKED_LIST LCMREF LCMCAL ; ;
CHARACTER KEY ;
INTEGER IPOS ;
REAL EPSILON ;
:: >>KEY<< >>IPOS<< >>EPSILON<< ;
INTEGER ITYREF ITYCAL ;
REAL VREF VCAL DELTA DENOM ;
DOUBLE PRECISION DREF DCAL ;
MODULE GREP: ABORT: END: ;
*
GREP: LCMREF :: TYPE <<KEY>> >>ITYREF<< ;
IF ITYREF 2 = THEN
  GREP: LCMREF :: GETVAL <<KEY>> <<IPOS>> >>VREF<< ;
ELSEIF ITYREF 4 = THEN
  GREP: LCMREF :: GETVAL <<KEY>> <<IPOS>> >>DREF<< ;
  EVALUATE VREF := DREF D_TO_R ;
ELSE
  PRINT "assertS_pair: INVALID REFERENCE TYPE=" ITYREF ;
  ABORT: ;
ENDIF ;
GREP: LCMCAL :: TYPE <<KEY>> >>ITYCAL<< ;
IF ITYCAL 2 = THEN
  GREP: LCMCAL :: GETVAL <<KEY>> <<IPOS>> >>VCAL<< ;
ELSEIF ITYCAL 4 = THEN
  GREP: LCMCAL :: GETVAL <<KEY>> <<IPOS>> >>DCAL<< ;
  EVALUATE VCAL := DCAL D_TO_R ;
ELSE
  PRINT "assertS_pair: INVALID CALCULATED TYPE=" ITYCAL ;
  ABORT: ;
ENDIF ;
EVALUATE DENOM := VREF ABS ;
IF DENOM 1.0E-30 < THEN
  EVALUATE DENOM := 1.0E-30 ;
ENDIF ;
EVALUATE DELTA := VCAL VREF - DENOM / ABS ;
IF DELTA EPSILON < THEN
  PRINT "TEST SUCCESSFUL; DELTA=" DELTA ;
ELSE
  PRINT "------------" ;
  PRINT "TEST FAILURE" ;
  PRINT "------------" ;
  PRINT "REFERENCE=" VREF " CALCULATED=" VCAL ;
  ABORT: ;
ENDIF ;
END: ;
