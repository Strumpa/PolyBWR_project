#!/bin/sh
if [ $# = 0 ]
   then
   echo "usage: glow_r120.access directory" 1>&2
   exit 1
fi
if [ -z "$SALOME_DIST" ]; then
   echo "SALOME_DIST is not set"
   exit 1
else
   echo "SALOME_DIST has the value: $SALOME_DIST"
fi
mkdir workdir
cd workdir
ln -s $1/data/glow_r120_proc/fa_r120_macro.py .
ln -s $1/data/glow_r120_proc/fa_r120.py .
source $1/../script/start_env_MacOS.sh
python3 fa_r120_macro.py 2> /dev/null
python3 fa_r120.py 2> /dev/null
cd ..
rm -r workdir
ls -l
echo "glow_r120 access script terminated"
