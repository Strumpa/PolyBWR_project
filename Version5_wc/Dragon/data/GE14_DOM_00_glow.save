#!/bin/sh
#
if [ $# = 0 ]
   then
   echo "usage: GE14_DOM_00_glow.save directory" 1>&2
   exit 1
fi
echo "access GE14_DOM_00_glow.save"
MACH=`uname -s`
Sysx="`echo $MACH | cut -b -6`"
if [ $Sysx = "CYGWIN" ]; then
   MACH=`uname -o`
elif [ $Sysx = "AIX" ]; then
   MACH=`uname -s`
else
   MACH=`uname -sm | sed 's/[ ]/_/'`
fi
ls -l

mv *.ps $1/"$MACH"
mv CPO* $1/"$MACH"
echo "GE14_DOM_00_glow.save completed"

