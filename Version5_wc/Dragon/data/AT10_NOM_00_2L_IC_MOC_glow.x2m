* Cle2000 procedure to treat the ATRIUM10 fuel bundle from glow defined geometry.
* 2-level calculation scheme to ensure consistency between starterDD 
* + glow with native DRAGON geometry and material numbering.

* ssh : 295 groups IC selfshielding with RSE method, simple geometry
* 1st level : 295 groups IC calculation on geometry with windmills in coolant
* 2nd level : 26 groups MOC calculaion on finely meshed geometry with windmills in coolant, 
* using 1st level cross sections condensed to 26 groups.

MODULE LIB: G2S: SALT: MCCGT: USS: ASM: FLU: EDI: SPH: GREP: DELETE: END: ;
PROCEDURE assertS MIX_AT10 EDIRAT10 ;
LINKED_LIST  LIBRARY LIBRARY2 TRKSSH TRKIC TRKMOC SYS FLUX LIB26G EDITION ;

SEQ_BINARY TRKFILSSH TRKFILIC TRKFILMOC ;
REAL keffIC keffMOC ;


***********************************************
* TDT files from glow : imports
***********************************************

SEQ_ASCII tdt_iso_ssh :: FILE 'AT10_DOM_SSH_IC_TISO_MACRO.dat' ;
SEQ_ASCII tdt_iso_ic :: FILE 'AT10_DOM_FLUXL1_IC_TISO_MACRO.dat' ;
SEQ_ASCII tdt_spc_moc :: FILE 'AT10_DOM_FLUXL2_MOC_TSPC.dat' ;

*******************************************************
* Post script formatted files for plotting with G2S:
*******************************************************

SEQ_ASCII ssh.ps :: FILE 'AT10_DOM_TISO_ssh_IC_glow.ps' ;
SEQ_ASCII IC_tiso.ps :: FILE 'AT10_DOM_TISO_IC_glow.ps' ;
SEQ_ASCII moc_tspc.ps :: FILE 'AT10_DOM_TSPC_moc_glow.ps' ;


**********************************************************
* Check geometries by printing surface elements with G2S:
**********************************************************

ssh.ps := G2S: tdt_iso_ssh :: ;
IC_tiso.ps := G2S: tdt_iso_ic :: ;
moc_tspc.ps := G2S: tdt_spc_moc :: ;


**********************************************************
* Track tdt from glow with SALT: 
**********************************************************

* Self-shielding geometry
TRKSSH TRKFILSSH := SALT: tdt_iso_ssh ::
    EDIT 1
    TITLE 'IC ATRIUM-10 CASE - self-shielding - glow'
    BATCH 200
    ANIS 1
    TISO EQW 8 15.0
    IC EPSJ 1.0E-5
;

* 1st level geometry with windmills in coolant
TRKIC TRKFILIC := SALT: tdt_iso_ic ::
	EDIT 1
	TITLE 'IC ATRIUM-10 CASE - 1st level - glow'
	BATCH 200
    ANIS 1
	TISO EQW 12 25.0
	IC EPSJ 1.0E-5
;

* 2nd level geometry with windmills in coolant
TRKMOC TRKFILMOC := SALT: tdt_spc_moc ::
    EDIT 1
    ALLG LONG
    BATCH 2000
    GAUS
    ANIS 1
    TSPC EQW2 24 50.0 REND
    NOIC
;

* MOC tracking
TRKMOC := MCCGT: TRKMOC TRKFILMOC ::
    EDIT 1
    GAUS 4 AAC 100 ILU0 
    HDD 0.0 SC KRYL 10
;

**********************************************
* LIBRARY creation 
**********************************************

LIBRARY := MIX_AT10 :: 'endfb8r1_295' 'RSE' 2 'APOL' 900.0 600.0 600.0 600.0 600.0 600.0 ;

******************************************************************
* USS: call to create the self-shielded cross sections library
******************************************************************

LIBRARY2 := USS: LIBRARY TRKSSH TRKFILSSH ::
	EDIT 1 ARM
	;

TRKSSH TRKFILSSH := DELETE: TRKSSH TRKFILSSH ;

*****************************************************************************
* ASM: call to create system to be solved at the first level flux calculaton
*****************************************************************************
SYS := ASM: LIBRARY2 TRKIC TRKFILIC ::
	EDIT 1 ARM
	;
	
*******************************************************************
* FLU: call to solve the system at the first level flux calculation
*******************************************************************

FLUX := FLU:  SYS LIBRARY2 TRKIC :: EDIT 1 TYPE K ;
GREP: FLUX :: GETVAL 'K-EFFECTIVE' 1 1 1 >>keffIC<< ;
ECHO "ATRIUM10 assembly with glow @level 1, keff=" keffIC ;

***************************************************************************
* CONDENSATION OF 1st LEVEL FLUX on 295 energy groups to 26 energy groups
***************************************************************************

EDITION := EDI: FLUX LIBRARY2 TRKIC ::
    EDIT 0
    MICR ALL
    MERG MIX
    COND  10  14  18  26  33  40  49  56  66 84 150 210 241 244 247
    252 255 258 261 268 273 277 281 286 291
    SAVE ON COND26 
;

LIB26G := EDITION :: STEP UP COND26 ;

LIB26G := SPH: LIB26G TRKIC TRKFILIC :: EDIT 1 ITER 1 ;

FLUX SYS EDITION TRKIC TRKFILIC := DELETE: FLUX SYS EDITION TRKIC TRKFILIC ;

***************************************
* 	2nd LEVEL FLUX CALCULATION
***************************************
SYS := ASM: LIB26G TRKMOC TRKFILMOC :: ARM EDIT 1 ;

FLUX := FLU: LIB26G SYS TRKMOC TRKFILMOC ::
      EDIT 1 TYPE K 
    ;

GREP: FLUX :: GETVAL 'K-EFFECTIVE' 1 1 1 >>keffMOC<< ;
ECHO "ATRIUM10 assembly with glow @level 2, keff=" keffMOC ;

EDIRAT10 FLUX LIB26G TRKMOC :: '_CPO_AT10_NOM_00_2L_IC_MOC_glow_P0_CTRA_noGRMAX_iter1' ;

END: ;
QUIT .

