*-------------------------------------------------------------------------------------------------
*  Name          : fa1_2level_370.x2m                                                                
*  Author        : C. De Santis, G. Cirillo
*-------------------------------------------------------------------------------------------------
SEQ_ASCII tiso :: 
       FILE './fa1_tiso_macro.dat' 
       ;
SEQ_ASCII tiso_sect :: 
       FILE './fa1_tiso_macro_sect.dat' 
       ;
SEQ_ASCII tspc_sect :: 
       FILE './fa1_tspc_sect.dat' 
       ;
SEQ_ASCII fa.eps ::  
       FILE './fa1-2level.eps' 
       ;
SEQ_ASCII _Compo ::  
       FILE './_fa1-compo.txt' 
       ;
SEQ_BINARY Track_f1 Track_tspc Track_f_ssh ;

*-------------------------------------------------------------------------------------------------
*  Define STRUCTURES and MODULES used
*-------------------------------------------------------------------------------------------------
LINKED_LIST
    Micro Track1 Track2 Track_ssh MicroSS MicroCond System Flux EdiCond Out Mgeom Mout Compo
    ;

MODULE
    LIB: SALT: MCCGT: GEO: G2S: TONE: ASM: FLU: EDI: SPH: COMPO: DELETE: ABORT: GREP: END:
    ;

PROCEDURE
    SPH_FixedPt assertS
    ;

*-------------------------------------------------------------------------------------------------
*  Temperatures and densities
*-------------------------------------------------------------------------------------------------
REAL temp_cool temp_cld_498 temp_cld_475 ;    (*[K]*)
REAL temp_fuel := 1019.0 ;
EVALUATE temp_cool := 475.0 273.0 + ;
EVALUATE temp_cld_498 := 498.0 273.0 + ;
EVALUATE temp_cld_475 := 475.0 273.0 + ; 
REAL densMOX1 := 10.327650876353518 ;      (*Fuel_01*)               (*[g/cm3]*)
REAL densMOX2 := 10.322112389569925 ;      (*Fuel_02*)
REAL dens_cool := 10.41336958 ;
REAL dens_cool475 := 10.48374208 ;
REAL dens_cld_498 := 7.756509317 ; 
REAL dens_cld_475 := 7.765709065 ;
REAL densHe_475 := 0.000155929365097611 ;
REAL densHe_498 := 0.00015129 ; ! calcolata con legge gas perfetti
REAL densB4C_42 := 2.16754 ;
REAL densMIXTRANS := 9.910508917136502 ; ! volume-fraction-weighed average between lead and clad

STRING  SPHType := "FixedPt" ;
INTEGER IterEmax := 10 ;
INTEGER m := 2 ; ! Anderson window size
REAL keff ;

*-------------------------------------------------------------------------------------------------
*  Microlib: DRAGLIB ENDFB_VIIr1 SHEM 370 groups
*-------------------------------------------------------------------------------------------------
Micro := LIB: ::
    EDIT 2
    NMIX 5
    CTRA NONE
    ANIS 2
    MIXS LIB: DRAGON FIL: DLIB_370
        MIX 1 <<temp_cld_475>> <<dens_cool475>> (*LEAD*)
            Pb204  = Pb204 0.01377877
            Pb206  = Pb206 0.23951907
            Pb207  = Pb207 0.22070984
            Pb208  = Pb208 0.52584231
        MIX 2 <<temp_cld_498>> <<dens_cld_498>> (*CLAD1*)
            Cr50   = Cr50  0.006051845
            Cr52   = Cr52  0.121364076
            Cr53   = Cr53  0.014026701
            Cr54   = Cr54  0.003557378
            Ni58   = Ni58  0.104156603
            Ni60   = Ni60  0.041502587
            Ni61   = Ni61  0.001834207
            Ni62   = Ni62  0.005944138
            Ni64   = Ni64  0.001562464
            Mn55   = Mn55  0.015
            Mo92   = Mo92  0.002087446
            Mo94   = Mo94  0.001343111
            Mo95   = Mo95  0.002349904
            Mo96   = Mo96  0.002499063
            Mo97   = Mo97  0.001454200
            Mo98   = Mo98  0.003732677
            Mo100  = Mo100 0.003732677
            Ti46   = Ti46  0.000316803
            Ti47   = Ti47  0.000291911
            Ti48   = Ti48  0.002953802
            Ti49   = Ti49  0.000221288
            Ti50   = Ti50  0.000216195
            Fe54   = Fe54  0.036902756
            Fe56   = Fe56  0.600723533      1
            Fe57   = Fe57  0.014121466
            Fe58   = Fe58  0.001912246
        MIX 3 <<temp_cld_498>> <<densHe_498>> GAS (*HELIUM*)
            He4    = He4   1.0
        MIX 4 <<temp_fuel>> <<densMOX1>>  (*FUEL*)
            O16    = O16   0.118373506
            U234   = U234  0.001201395
            U235   = U235  0.132195724      2
            U238   = U238  0.747907710      2
        MIX 5 <<temp_cld_475>> <<dens_cld_475>> (*CLAD2*)
            Cr50   = Cr50  0.006051845
            Cr52   = Cr52  0.121364076
            Cr53   = Cr53  0.014026701
            Cr54   = Cr54  0.003557378
            Ni58   = Ni58  0.104156603
            Ni60   = Ni60  0.041502587
            Ni61   = Ni61  0.001834207
            Ni62   = Ni62  0.005944139
            Ni64   = Ni64  0.001562464
            Mn55   = Mn55  0.015
            Mo92   = Mo92  0.002087446
            Mo94   = Mo94  0.001343112
            Mo95   = Mo95  0.002349904
            Mo96   = Mo96  0.002499064
            Mo97   = Mo97  0.001454200
            Mo98   = Mo98  0.003732677
            Mo100  = Mo100 0.003732677
            Ti46   = Ti46  0.000316804
            Ti47   = Ti47  0.000291911
            Ti48   = Ti48  0.002953802
            Ti49   = Ti49  0.000221288
            Ti50   = Ti50  0.000216195
            Fe54   = Fe54  0.036902756
            Fe56   = Fe56  0.600723533      3
            Fe57   = Fe57  0.014121465
            Fe58   = Fe58  0.001912246
            ;

*-------------------------------------------------------------------------------------------------
*  Begin compo initialization
*-------------------------------------------------------------------------------------------------
Compo := COMPO: ::
  EDIT 10
  STEP UP 'NOMINAL'
  MAXCAL 1
  COMM 'fa1_2level_370 LFR Assembly' ENDC
  GFF
  INIT
;

*-------------------------------------------------------------------------------------------------
*  Plotting and tracking of the imported geometry
*-------------------------------------------------------------------------------------------------
fa.eps := G2S: tspc_sect :: EDIT 0 ;

Track_ssh Track_f_ssh := SALT: tiso ::
     EDIT 1
     ALLG 
     BATCH 300
     TISO 12 100.0
     MERGMIX
     IC
     ;

*-------------------------------------------------------------------------------------------------
*  Resonance self-shielding calculation 
*-------------------------------------------------------------------------------------------------
MicroSS := TONE: Micro Track_ssh Track_f_ssh ::
     EDIT 1
     GRMIN 15     (*2.865 MeV*)
     GRMAX 281    (*4.63 ev*)
     PIJ
     ;

Track1 Track_f1 := SALT: tiso_sect ::
     EDIT 1
     ALLG 
     BATCH 300
     TISO 12 100.0
     IC
     ;

System := ASM: MicroSS Track1 Track_f1 :: EDIT 1 ARM ;
Flux := FLU: System MicroSS Track1 Track_f1 :: EDIT 1 TYPE K P1 EXTE 1.0E-6 ;

EdiCond := EDI: MicroSS Track1 Flux tiso_sect System :: 
    EDIT 2
    MICR ALL
    MERG MIX
    COND  4 9 13 17 21 28 40 51 61 73 82 89 100 108 117 122 128 135 139 145 154 161 186
    204 212 235 248 260 270 285 338 354
    SAVE ON COND33
;

MicroCond := EdiCond :: STEP UP COND33 ;
IF SPHType "SPH" = THEN
  *-----------------------------------------------------------------------------------------------
  *  SPH strategy based on module SPH:
  *-----------------------------------------------------------------------------------------------
  MicroCond := SPH: MicroCond Track1 Track_f1 :: 
       EDIT 2 ITER 1.0E-5 
  ;
ELSEIF SPHType "FixedPt" = THEN
  *-----------------------------------------------------------------------------------------------
  *  Alternate SPH strategy based on a fixed point approach (Anderson accelerated)
  *-----------------------------------------------------------------------------------------------
  MicroCond  := SPH_FixedPt MicroCond Track1 Track_f1
     :: 0.0 10.0 1.0E-7 <<IterEmax>> <<m>> ;
ELSEIF SPHType "None" = THEN
  *-----------------------------------------------------------------------------------------------
  *  No SPH correction
  *-----------------------------------------------------------------------------------------------
ELSE
  ECHO SPHType "option is invalid" ;
  ABORT: ;
ENDIF ;

System Flux := DELETE: System Flux ;

*-------------------------------------------------------------------------------------------------
*  Second level flux calculation 
*-------------------------------------------------------------------------------------------------
Track2 Track_tspc := SALT: tspc_sect ::
     EDIT 1
     ALLG 
     BATCH 300
     TSPC 12 100.0
     ;
Track2 := MCCGT: Track2 Track_tspc ::
  CACB 4 AAC 80 TMT EPSI 1E-5 MCU 10000 ;

System := ASM: MicroCond Track2 Track_tspc :: EDIT 1 ARM ;
Flux := FLU: System MicroCond Track2 Track_tspc :: EDIT 1 TYPE K P1 EXTE 1.0E-6 ;

*-------------------------------------------------------------------------------------------------
*  Edition
*-------------------------------------------------------------------------------------------------
Out := EDI: MicroCond Track2 Flux ::
   EDIT 3
   MICR RES
   MERG COMP 
   SAVE ON 'NOMINAL'
;

*----
*  Construct the macro-geometry
*----
Mgeom := GEO: :: MACRO 24 REGIONS
  POLY 5  0.0 0.0   2.025 0.0   2.025 0.38971143   1.42128129 0.73826859   1.385640654 0.8
  POLY 5  2.025 0.0   3.375 0.0   3.375 0.38971143   2.7 0.77942286   2.025 0.38971143
  POLY 5  1.385640654 0.8    1.42128129 0.73826859   2.025 0.38971143   2.7 0.77942286   2.7 1.55884572
  POLY 5  3.375 0.0   4.725 0.0   4.725 0.38971143   4.05 0.77942286   3.375 0.38971143
  HEXA    2.7 1.55884572   2.7 0.77942286   3.375 0.38971143   4.05 0.77942286   4.05 1.55884572   3.375 1.94855715
  POLY 5  4.725 0.0   6.075 0.0   6.075 0.38971143   5.4 0.77942286   4.725 0.38971143
  HEXA    4.05 1.55884572   4.05 0.77942286   4.725 0.38971143   5.4 0.77942286   5.4  1.55884572   4.725 1.94855715
  QUAD    3.375 1.94855715   4.05 1.55884572   4.725 1.94855715   4.725 2.72798006
  POLY 5  6.075 0.0   7.425 0.0   7.425 0.38971143   6.75 0.77942286   6.075 0.38971143
  HEXA    5.4  1.55884572   5.4 0.77942286   6.075 0.38971143   6.75 0.77942286   6.75 1.55884572   6.075 1.94855715
  HEXA    4.725 2.72798006   4.725 1.9485572   5.4  1.55884572   6.075 1.94855715   6.075 2.72798006   5.4 3.11769143
  POLY 5  7.425 0.0   8.775 0.0   8.775 0.38971143 8.1 0.77942286 7.425 0.38971143
  HEXA    6.75 1.55884572   6.75 0.77942286   7.425 0.38971143   8.1 0.77942286   8.1 1.55884572   7.425 1.94855715
  HEXA    6.075 2.72798006   6.075 1.9485572   6.75 1.55884572   7.425 1.94855715   7.425 2.72798006   6.75 3.11769143
  QUAD    5.4 3.11769143   6.075 2.72798006   6.75 3.11769143   6.75 3.89711436
  POLY 5  8.775 0.0   10.125 0.0   10.125 0.38971143   9.45 0.77942286   8.775 0.38971143
  HEXA    8.1 1.55884572   8.1 0.77942286   8.775 0.38971143   9.45 0.77942286 9.45 1.55884572 8.775 1.94855715
  HEXA    7.425 2.72798006   7.425 1.9485572   8.1 1.55884572   8.775 1.94855715   8.775 2.72798006   8.1 3.11769143
  HEXA    6.75 3.89711436   6.75 3.1176915   7.425 2.72798006   8.1 3.1176915   8.1 3.89711436  7.425  4.28682573
  POLY 6  10.125 0.0   11.475 0.0   11.475 0.32471698   11.418713156 0.422208653   10.8 0.77942286   10.125 0.38971143
  POLY 7  9.45 1.55884572   9.45 0.77942286   10.125 0.38971143   10.8 0.77942286   10.8 1.4938513
          10.743713156 1.591342973   10.125 1.9485572
  POLY 7  8.775 2.72798006   8.775 1.9485572   9.45 1.55884572   10.125 1.9485572   10.125 2.66298561
          10.068713156 2.760477273   9.45 3.1176915
  POLY 7  8.1 3.89711436   8.1 3.1176915   8.775 2.72798006   9.45 3.1176915   9.45 3.8321199
          9.393713156 3.929611573   8.775 4.2868257
  POLY 5  7.425  4.28682573   8.1 3.89711436   8.775 4.2868257   8.775 5.00125411   8.746856578 5.05
  CENTER  0.0 0.0 REFL
    ;

*-------------------------------------------------------------------------------------------------
*  Macro-geometry edition
*-------------------------------------------------------------------------------------------------
Mout := EDI: MicroCond Track2 Flux tspc_sect Mgeom ::
   EDIT 3
   MERG G2S Mgeom
   SAVE ON 'NOMINAL'
;

*-------------------------------------------------------------------------------------------------
*  Multicompo feeding
*-------------------------------------------------------------------------------------------------
Compo := COMPO: Compo Out Mout ::
   EDIT 2
   STEP UP 'NOMINAL'
;
_Compo := Compo ;

GREP: Flux :: GETVAL 'K-EFFECTIVE' 1 1 1 >>keff<< ;
ECHO "keff=" keff ;
assertS Flux :: K-EFFECTIVE 1 1.182401 ;
ECHO "test fa1_2level_370 completed" ;
END: ;
QUIT "LIST" .
