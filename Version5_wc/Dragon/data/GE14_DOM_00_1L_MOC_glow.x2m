* Cle2000 procedure to treat the GE14 DOM slice from glow defined geometry.
* 1-level calculation scheme to ensure consistency between starterDD 
* + glow with native DRAGON geometry and material numbering.

* ssh : 295 groups IC selfshielding with RSE method, simple geometry
* 1st level : 295 groups MOC calculaion on finely meshed geometry with windmills in coolant, 

MODULE LIB: G2S: SALT: MCCGT: USS: ASM: FLU: EDI: SPH: GREP: DELETE: END: ;
PROCEDURE assertS MIXGE14 EDIRGE14 ;
LINKED_LIST  LIBRARY LIBRARY2 TRKSSH TRKMOC SYS FLUX ;

SEQ_BINARY TRKFILSSH TRKFILMOC ;
REAL keffIC keffMOC ;

STRING exec := "True" ;
INTEGER o_anis := 4 ;
STRING name_compo := '_CPO_GE14_DOM_IC_1L_MOC_ANIS4_finer_water_rods_8_moder_3016_corners4' ;
STRING Draglib := 'endfb8r1_295' ; !'e81_295_P5'
***********************************************
* TDT files from glow : imports
***********************************************

SEQ_ASCII tdt_iso_ssh :: FILE 'GE14_DOM_SSH_IC_TISO_MACRO.dat' ;
!SEQ_ASCII tdt_spc_moc :: FILE 'GE14_DOM_FLUXL2_MOC_TSPC.dat' ;
!SEQ_ASCII tdt_spc_moc :: FILE 'GE14_DOM_FLUXL2_finer_water_rods_MOC_TSPC.dat' ;
SEQ_ASCII tdt_spc_moc :: FILE 'GE14_DOM_FLUXL2_finer_water_rods8_mode3016_subdcoolcorners4_MOC_TSPC.dat' ;

*******************************************************
* Post script formatted files for plotting with G2S:
*******************************************************

SEQ_ASCII ssh.ps :: FILE 'GE14_DOM_TISO_ssh_IC_glow.ps' ;
SEQ_ASCII moc_tspc.ps :: FILE 'GE14_DOM_TSPC_moc_glow.ps' ;


**********************************************************
* Check geometries by printing surface elements with G2S:
**********************************************************

ssh.ps := G2S: tdt_iso_ssh :: ;
moc_tspc.ps := G2S: tdt_spc_moc :: ;


**********************************************************
* Track tdt from glow with SALT: 
**********************************************************

* Self-shielding geometry
TRKSSH TRKFILSSH := SALT: tdt_iso_ssh ::
    EDIT 1
    TITLE 'IC GE14 DOM CASE - self-shielding - glow'
    BATCH 200
    TISO EQW 8 25.0
    IC EPSJ 1.0E-5
;


* 2nd level geometry with windmills in coolant
TRKMOC TRKFILMOC := SALT: tdt_spc_moc ::
    EDIT 1
    ALLG LONG
    BATCH 2000
    GAUS
    ANIS <<o_anis>>
    TSPC EQW2 30 115.0 REND
    NOIC
;

* MOC tracking
TRKMOC := MCCGT: TRKMOC TRKFILMOC ::
    EDIT 1
    GAUS <<o_anis>> AAC 100 ILU0 
    HDD 0.0 SC KRYL 10
;

IF exec 'True' = THEN
**********************************************
* LIBRARY creation 
**********************************************

LIBRARY := MIXGE14 :: <<Draglib>> 'RSE' <<o_anis>> 'NONE' 900.0 600.0 600.0 600.0 600.0 600.0 ;

******************************************************************
* USS: call to create the self-shielded cross sections library
******************************************************************

LIBRARY2 := USS: LIBRARY TRKSSH TRKFILSSH ::
	EDIT 1 ARM
	;

TRKSSH TRKFILSSH := DELETE: TRKSSH TRKFILSSH ;

*****************************************************************************
* ASM: call to create system to be solved at the first level flux calculaton
*****************************************************************************
SYS := ASM: LIBRARY2 TRKMOC TRKFILMOC ::
	EDIT 1 ARM
	;
	
*******************************************************************
* FLU: call to solve the system at the first level flux calculation
*******************************************************************

FLUX := FLU:  SYS LIBRARY2 TRKMOC TRKFILMOC :: EDIT 1 TYPE K ;
GREP: FLUX :: GETVAL 'K-EFFECTIVE' 1 1 1 >>keffMOC<< ;
ECHO "GE14 DOM assembly with glow (1L_MOC), keff=" keffMOC ;


EDIRGE14 FLUX LIBRARY2 TRKMOC :: <<name_compo>> ;
ENDIF ;

END: ;
QUIT .

