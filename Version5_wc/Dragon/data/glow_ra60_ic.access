#!/bin/sh
if [ $# = 0 ]
   then
   echo "usage: glow_ra60_ic.access directory" 1>&2
   exit 1
fi
if [ -z "$SALOME_DIST" ]; then
   echo "SALOME_DIST is not set"
   exit 1
else
   echo "SALOME_DIST has the value: $SALOME_DIST"
fi
mkdir workdir
cd workdir
ln -s $1/data/glow_ra60_ic_proc/fa_ra60_macro.py .
source $1/../script/start_env_MacOS.sh
python3 fa_ra60_macro.py 2> /dev/null
cd ..
rm -r workdir
ls -l
echo "glow_ra60_ic access script terminated"
