MACRO4G := MAC: MACRO4G_0 ::
 NMIX 12
 MIX     1    1  OLDL
 MIX     2    2  OLDL
 MIX     3    3  OLDL
 MIX     4    4  OLDL
 MIX     5    4  OLDL
 MIX     6    4  OLDL
 MIX     7    4  OLDL
 MIX     8    8  OLDL
 MIX     9    1  OLDL
 MIX    10   10  OLDL
 MIX    11   10  OLDL
 MIX    12   12  OLDL
;
*
*-----------------------------------------------------
*-----------------------------------------------------
*-----------------------------------------------------
*  TISO/IC solution
*-----------------------------------------------------
TDT_LAT_PS := G2S: TDT_LAT_IC :: EDIT 0 ;
TRACK TRACK_f := SALT: TDT_LAT_IC ::
    TITL 'glow_bwr TISO/IC imported'
    EDIT 1
    ANIS 1
    TISO 12 20.0
    REND LONG
    IC
    ;

*-----------------------------------------------------
*  Flux calculation
*-----------------------------------------------------
CP := ASM: MACRO4G TRACK TRACK_f :: ARM ;
FLUX := FLU: MACRO4G CP TRACK TRACK_f :: TYPE K ;
assertS FLUX :: 'K-EFFECTIVE' 1 0.9826580 ;
TRACK TRACK_f CP FLUX := DELETE: TRACK TRACK_f CP FLUX ;
*-----------------------------------------------------
*-----------------------------------------------------
*-----------------------------------------------------
*  TSPC/MOC solution
*-----------------------------------------------------
TRACK TRACK_f := SALT: TDT_LAT_TSPC ::
    TITL 'glow_bwr TSPC/MOC imported'
    EDIT 1
    ANIS 1
    TSPC 12 20.0
    REND LONG
    NOIC
    ;

TRACK := MCCGT: TRACK TRACK_f ::
  EDIT 1
  LCMD 3 AAC 150 TMT SCR 0 EPSI 1E-5
  MAXI 1 KRYL 0 HDD 0.0 ;

*-----------------------------------------------------
*  Flux calculation
*-----------------------------------------------------
CP := ASM: MACRO4G TRACK TRACK_f :: ARM ;
FLUX := FLU: MACRO4G CP TRACK TRACK_f :: TYPE K ;
assertS FLUX :: 'K-EFFECTIVE' 1 0.9802172 ;

*-----------------------------------------------------
*  Editing
*-----------------------------------------------------
OUT := EDI: MACRO4G TRACK FLUX ::
    EDIT 4
    MERG COMP
    COND
    ;

ECHO "test glow_bwr completed" ;
END: ;
QUIT "LIST" .
