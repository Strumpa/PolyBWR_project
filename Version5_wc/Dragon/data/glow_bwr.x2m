*-----------------------------------------------------
*  Name          : glow_bwr.x2m
*  Author        : Raphael Guasch
*  MODEL TO TEST GLOW BWR GEOMETRIES
*-----------------------------------------------------
*  Define STRUCTURES and MODULES used
*-----------------------------------------------------
SEQ_ASCII TDT_LAT_TSPC :: FILE './PB2_Type6-C_DIAG_MOC_TSPC_glow_test.dat' ;
SEQ_ASCII TDT_LAT_IC :: FILE './PB2_Type6-C_DIAG_IC_MACRO_TISO_glow_test.dat' ;
MODULE
    G2S: MAC: SALT: MCCGT: ASM: FLU: EDI: DELETE: END: ABORT: ;
LINKED_LIST
    MACRO4G_0 MACRO4G TRACK CP FLUX OUT ;
SEQ_BINARY
    TRACK_f ;
SEQ_ASCII TDT_LAT_PS :: FILE './fa_glow_bwr_macro.eps' ;
PROCEDURE assertS ;
*----
*  Input Macrolib
*----
MACRO4G_0 := MAC: ::
