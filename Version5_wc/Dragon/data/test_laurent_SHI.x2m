INTEGER i_Tfuel := 0 ;
INTEGER n_Tcool := 1 ;
INTEGER i_Tcool := 0 ;
INTEGER n_DCool := 1 ;
INTEGER i_DCool := 0 ;
INTEGER n_dens := 1 ;
REAL TFuel ;
REAL TCool ;
REAL DCool ;
REAL N_H ;
REAL N_O ;
REAL keffL1 ;
REAL keffL2 ;
REAL TFUEL := 900.0 ;
REAL TBOX := 600.0 ;
REAL TCLAD := 600.0 ;
REAL TCOOL := 600.0 ;
REAL TMODE := 600.0 ;
REAL TCTRL := 600.0 ;

SEQ_ASCII tdtssh :: FILE 'GE14_DOM_DIAG_SSH.dat' ;
SEQ_ASCII tdtfluxl1 :: FILE 'GE14_DOM_DIAG_FLUXL1.dat' ;
