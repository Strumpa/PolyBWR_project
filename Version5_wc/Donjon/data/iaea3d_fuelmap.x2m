*---
*  Define the fuel map
*---
IAEA3D_2 MATEX := USPLIT: IAEA3D :: EDIT 1
NGRP 2 MAXR 40500 NMIX 5
NREFL 2 RMIX 4 5
NFUEL 3 FMIX 1 2 3
;

FLMAP MATEX := RESINI: MATEX :: 
      ::: GEO: CAR3D 17 17 4
                EDIT  0
                X- VOID      X+ VOID
                Y- VOID      Y+ VOID
                Z- VOID      Z+ VOID
