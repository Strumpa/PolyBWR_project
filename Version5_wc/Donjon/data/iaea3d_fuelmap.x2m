NXNAME '-' 'R' 'P' 'N' 'M' 'L' 'K' 'J' 'H' 'G' 'F' 'E' 'D' 'C'
        'B' 'A' '-'
NYNAME  '--' '01' '02' '03' '04' '05' '06' '07' '08' '09'
        '10' '11' '12' '13' '14' '15' '--'
NCOMB ALL                            
;

MACRO2 MATEX := MACINI: MATEX MACRO :: EDIT 1 ;
*---
*  Solve for the flux
*---
TRACK := TRIVAT: IAEA3D_2 ::
      TITLE 'TEST IAEA 3D'
      EDIT 1 MAXR 40500 DUAL 3 3 ;

SYSTEM := TRIVAA: MACRO2 TRACK ::
      EDIT 1 ;

FLUX := FLUD: SYSTEM TRACK ::
      EDIT 2 EXTE 1.0E-7 1000 ;

POWER := FLPOW: FLMAP FLUX TRACK MATEX MACRO2
  :: EDIT 10 PTOT 1000.0  PRINT ALL ;

GREP: FLUX :: GETVAL 'K-EFFECTIVE' 1 >>Keff<< ;
ECHO "Keff=" Keff ;

assertS FLUX :: 'K-EFFECTIVE' 1 1.028980 ;

ECHO "Test iaea3d_fuelmap completed" ;
END: ;
